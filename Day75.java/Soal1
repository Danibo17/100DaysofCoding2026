import java.util.Scanner;
 public class TigaPerulangan {
     public static void main(String[] args) {
         Scanner input = new Scanner(System.in);
         
         System.out.print("Masukkan batas akhir n: ");
         int n = input.nextInt();
         
         for (int i = 1; i <= n; i++) {
             System.out.print(i + " ");
         }
         System.out.println();
        
         int j = 1;
         while (j <= n) {
             System.out.print(j + " ");
             j++;
         }
         System.out.println();
        
         int k = 1;
         do {
             System.out.print(k + " ");
             k++;
         } while (k <= n);
     }
 }
